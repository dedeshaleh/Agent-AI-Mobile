# Host (PC) toolchain for llama.cpp's vulkan-shaders-gen when cross-compiling for
# Android. Generated by CMakeLists.txt from the host compiler it found; passed to
# ggml via GGML_VULKAN_SHADERS_GEN_TOOLCHAIN. The tool runs on the build machine
# and only turns .comp shaders into SPIR-V byte arrays.
set(CMAKE_BUILD_TYPE Release)
set(CMAKE_C_FLAGS   -O2)
set(CMAKE_CXX_FLAGS -O2)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE NEVER)
set(CMAKE_C_COMPILER   "@AGENTHQ_HOST_C_COMPILER@")
set(CMAKE_CXX_COMPILER "@AGENTHQ_HOST_CXX_COMPILER@")
# Reuse the parent's ninja; the ExternalProject does not forward it and the
# Gradle daemon's PATH may not contain the SDK cmake/bin directory.
if (EXISTS "@AGENTHQ_HOST_MAKE_PROGRAM@")
  set(CMAKE_MAKE_PROGRAM "@AGENTHQ_HOST_MAKE_PROGRAM@" CACHE FILEPATH "" FORCE)
endif()
# MinGW: link the runtime statically so the generated exe runs without the
# compiler's bin directory on PATH.
if (CMAKE_CXX_COMPILER MATCHES "mingw|MinGW|WinLibs|msys")
  set(CMAKE_EXE_LINKER_FLAGS "-static" CACHE STRING "" FORCE)
endif()
